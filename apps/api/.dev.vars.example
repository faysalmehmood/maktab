# Copy to .dev.vars (gitignored) for `wrangler dev`.
# Generate a secret with: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
SESSION_SECRET=dev-only-secret-change-me-at-least-32-chars
# Parent links (link tokens, gate tokens, PIN and IP hashes); its own secret, >= 32 chars.
# Production: openssl rand -base64 48 | npx wrangler secret put PARENT_LINK_SECRET --env production
PARENT_LINK_SECRET=dev-only-parent-link-secret-change-me-32-chars
# OAuth client (Web application) with redirect URI http://localhost:5173/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Your Google address: on an empty database only this account becomes owner on first sign-in.
OWNER_EMAIL=
# Backup reports from GitHub Actions (POST /api/backup/runs, Bearer token, >= 32 chars). Optional
# locally; smoke:m6 sets its own. Production: docs/backup.md.
BACKUP_REPORT_TOKEN=dev-only-backup-report-token-change-me-32-chars

# Turnstile (optional; both or neither). Cloudflare's always-pass testing keys:
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET=1x0000000000000000000000000000000AA
