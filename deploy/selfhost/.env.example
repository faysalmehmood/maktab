# One school's settings for the self-hosted server (docs/self-host.md, "Environment").
# Copied to /srv/homelab/maktab/<instance>/.env by install.sh, which fills the three random secrets
# below when it creates the file. Keep this file mode 0600; never commit the real one.

# --- Required ------------------------------------------------------------------------------------
# The public address (no trailing slash). Cookies, CSRF and the Google redirect URI derive from it.
APP_ORIGIN=https://gsap.conceptlix.com
# >= 32 random characters each (openssl rand -base64 48). Changing SESSION_SECRET signs everyone out.
SESSION_SECRET=
# Parent links are HMACs under this; a restore needs the SAME value (docs/restore.md).
PARENT_LINK_SECRET=

# --- Sign-in -------------------------------------------------------------------------------------
# The only Google account that may claim the empty installation as owner.
OWNER_EMAIL=shahid.ics.pu@gmail.com
# Google OAuth client; authorised redirect URI: <APP_ORIGIN>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Backups -------------------------------------------------------------------------------------
# The PUBLIC age key (age1...) the nightly backup is encrypted to: the same value as the GitHub
# secret AGE_RECIPIENT. Empty = backups are stored unencrypted (a warning is logged).
AGE_RECIPIENT=
# Later: an rclone remote for the off-site copy (not implemented yet; leave empty).
BACKUP_RCLONE_REMOTE=
# Optional: lets an external job report runs to POST /api/backup/runs (>= 32 chars). Not needed for
# the built-in nightly backup, which records its runs directly.
BACKUP_REPORT_TOKEN=

# --- Optional ------------------------------------------------------------------------------------
# Cloudflare Turnstile (both or neither; docs/deploy.md section 8).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# 1 (default) = take the client IP from CF-Connecting-IP / X-Forwarded-For, set by the tunnel.
# Only for rate limits and the audit/access logs. Set 0 if anything but cloudflared can reach the
# container.
TRUST_PROXY=1
# Never set DEMO_MODE here: the server refuses to start with it.
