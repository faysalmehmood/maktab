# One school's settings for the self-hosted server (docs/self-host.md §5).
# install.sh copies this to /srv/homelab/maktab/<instance>/.env (mode 0600) and fills
# SESSION_SECRET, PARENT_LINK_SECRET and TRUST_PROXY_FROM when it creates the file.
# Never commit the real one.

# --- Required ------------------------------------------------------------------------------------
# The public address (no trailing slash). Cookies, CSRF and the Google redirect URI derive from it.
APP_ORIGIN=https://gsap.conceptlix.com
# >= 32 random characters each. Changing SESSION_SECRET signs everyone out.
SESSION_SECRET=
# Parent links are HMACs under this; a restore needs the SAME value (docs/restore.md).
PARENT_LINK_SECRET=
# The PUBLIC age key (age1...) the backups are encrypted to: the same value as the GitHub secret
# AGE_RECIPIENT. The server refuses to start without it (checked by encrypting one byte).
AGE_RECIPIENT=

# --- Sign-in -------------------------------------------------------------------------------------
# The only Google account that may claim the empty installation as owner.
OWNER_EMAIL=shahid.ics.pu@gmail.com
# Google OAuth client; authorised redirect URI: <APP_ORIGIN>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Client IP behind the tunnel ------------------------------------------------------------------
# The peers allowed to say who the client is (CF-Connecting-IP): the `homelab` Docker network's
# subnet, where cloudflared runs. install.sh fills it from `docker network inspect homelab`.
# Empty = trust nobody: every visitor looks like cloudflared and shares one rate-limit bucket.
TRUST_PROXY_FROM=

# --- Backups -------------------------------------------------------------------------------------
# The host's off-site copy target (docs/self-host.md §7 step 7.2), named in Settings → Backup.
BACKUP_RCLONE_REMOTE=
# Only for a test install: 1 = store backups unencrypted when AGE_RECIPIENT is empty.
ALLOW_UNENCRYPTED_BACKUPS=
# Optional: lets an external job report runs to POST /api/backup/runs (>= 32 chars). Not needed for
# the built-in nightly backup, which records its runs directly.
BACKUP_REPORT_TOKEN=

# --- Optional ------------------------------------------------------------------------------------
# Cloudflare Turnstile (both or neither; docs/deploy.md section 8).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Never set DEMO_MODE here: the server refuses to start with it.
