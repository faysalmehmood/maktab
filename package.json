{
  "name": "maktab",
  "version": "0.0.0",
  "private": true,
  "description": "Free, open-source school and academy management for Pakistani community schools",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/shared",
    "packages/db",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "predev": "node -e \"require('node:fs').mkdirSync('apps/web/dist', { recursive: true })\"",
    "dev": "concurrently -k -n web,api -c cyan,magenta \"npm run dev -w @maktab/web\" \"npm run dev -w @maktab/api\"",
    "build": "npm run build -w @maktab/web && npm run build -w @maktab/api",
    "test": "npm run test --workspaces --if-present",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run generate -w @maktab/db",
    "db:migrate:local": "npm run migrate:local -w @maktab/api",
    "db:seed": "npm run seed -w @maktab/db"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "concurrently": "10.0.6",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
